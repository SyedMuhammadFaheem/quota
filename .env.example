# Optional notification configuration for the Claude Quota agent.
# `quota setup` writes the real values to ~/.quota/.env (chmod 600) — you
# normally don't need to hand-edit this file. Copy it there only if you'd
# rather configure things manually.

# ntfy.sh (or self-hosted) push notifications
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Telegram bot notifications (create a bot via @BotFather, then message it once
# and look up your chat id, e.g. via https://api.telegram.org/bot<token>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Native desktop notifications -- macOS Notification Center, Linux notify-send,
# or a Windows balloon tip, depending on your OS. On by default.
# (MAC_NOTIFICATIONS is still honored as a backwards-compatible alias.)
OS_NOTIFICATIONS=true

# Comma-separated utilization thresholds (%) that trigger a warning notification
THRESHOLDS=80,90,95,100

# How often the background poller falls back to the oauth usage API (ms)
POLL_INTERVAL_MS=300000
